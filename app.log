SQL:
WITH cleaned AS (
  SELECT
    Title,
    TRY_CAST(REPLACE("Distance", ',', '.') AS DOUBLE) AS distance,
    TRY_CAST(REPLACE("Total Ascent", ',', '.') AS DOUBLE) AS total_ascent,
    TRY_CAST(REPLACE("Total Descent", ',', '.') AS DOUBLE) AS total_descent
  FROM data
  WHERE "Activity Type" = 'Running'
),
grouped AS (
  SELECT
    Title,
    distance,
    total_ascent,
    total_descent,
    COUNT(*) AS count
  FROM cleaned
  WHERE distance IS NOT NULL
    AND total_ascent IS NOT NULL
    AND total_descent IS NOT NULL
  GROUP BY
    ROUND(distance * 10) / 10,
    ROUND(total_ascent * 10) / 10,
    ROUND(total_descent * 10) / 10
)
SELECT COUNT(*) AS identified_tracks
FROM grouped
WHERE count > 1
