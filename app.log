WITH running_data AS (
    SELECT
        Date,
        TRY_CAST(REPLACE("Avg HR", ',', '.') AS DOUBLE) AS avg_hr,
        TRY_CAST(REPLACE("Max HR", ',', '.') AS DOUBLE) AS max_hr,
        ROW_NUMBER() OVER (ORDER BY Date) AS run_number
    FROM data
    WHERE "Activity Type" = 'Running'
      AND "Avg HR" IS NOT NULL
      AND "Avg HR" != ''
      AND "Avg HR" NOT LIKE '%-%'
),
stats AS (
    SELECT
        COUNT(*) AS n,
        AVG(run_number) AS avg_x,
        AVG(avg_hr) AS avg_y,
        SUM((run_number - AVG(run_number) OVER()) * (avg_hr - AVG(avg_hr) OVER())) AS cov_xy,
        SUM((run_number - AVG(run_number) OVER()) * (run_number - AVG(run_number) OVER())) AS var_x,
        MIN(Date) AS earliest_run,
        MAX(Date) AS latest_run,
        MIN(avg_hr) AS min_avg_hr,
        MAX(avg_hr) AS max_avg_hr,
        AVG(avg_hr) AS overall_avg_hr,
        CORR(run_number, avg_hr) AS correlation
    FROM running_data
),
trend AS (
    SELECT
        n,
        earliest_run,
        latest_run,
        min_avg_hr,
        max_avg_hr,
        ROUND(overall_avg_hr, 1) AS overall_avg_hr,
        ROUND(correlation, 4) AS correlation,
        ROUND(cov_xy / NULLIF(var_x, 0), 4) AS slope_bpm_per_run,
        CASE
            WHEN correlation > 0.3 THEN '📈 Upward trend: Avg HR is increasing over time'
            WHEN correlation < -0.3 THEN '📉 Downward trend: Avg HR is decreasing over time'
            ELSE '➡️ No clear trend: Avg HR is relatively stable over time'
        END AS trend_interpretation
    FROM stats
)
SELECT
    n AS total_runs,
    earliest_run,
    latest_run,
    overall_avg_hr,
    min_avg_hr,
    max_avg_hr,
    correlation AS pearson_correlation,
    slope_bpm_per_run AS bpm_change_per_run,
    trend_interpretation
FROM trend;
