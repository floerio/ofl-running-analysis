    mins = int(x) // 60
    secs = int(x) % 60
    return f'{mins}:{secs:02d}'

ax2.yaxis.set_major_formatter(plt.FuncFormatter(seconds_to_mmss))

# Add pace labels on line points
for x, y, pace in zip(df['Date_parsed'], df['Pace_seconds'], df['Avg Pace']):
