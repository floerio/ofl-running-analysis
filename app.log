df['Distance_float'] = df['Distance'].str.replace(',', '.').astype(float)

# Convert Avg Pace (MM:SS) to total seconds for plotting
def pace_to_seconds(pace_str):
    parts = pace_str.strip().split(':')
    return int(parts[0]) * 60 + int(parts[1])

df['Pace_seconds'] = df['Avg Pace'].apply(pace_to_seconds)

# Create figure with two y-axes
